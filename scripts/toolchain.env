# Pinned toolchain for ./dev — every build runs in these exact images, against this
# exact qmk_firmware commit, so a build can be repeated later. Update deliberately:
#   ./scripts/pull_toolchain.sh --refresh      (re-resolves the tags and rewrites this file)
# Digests and the QMK commit were last resolved on 2026-08-22.

# qmk CLI 1.2.0, arm-none-eabi-gcc 15.2.0 (qmk_toolchains a55a2b0)
QMK_IMAGE="qmkfm/qmk_cli@sha256:b7d7fa8fb4432b569931de5ad59098cb788f440ed61a62c5126746b71aee0f4a"
QMK_IMAGE_TAG="qmkfm/qmk_cli:latest"

# jekyll 4.4.1 — docs site preview/build (GitHub Pages uses its own gem set)
JEKYLL_IMAGE="jekyll/jekyll@sha256:f0ccb9842a530181f73fe2b126a01634810a52ec6667c4b804d9d09432eadf4a"
JEKYLL_IMAGE_TAG="jekyll/jekyll:4"

# OpenSCAD 2021.01 — headless STL export (no GL: PNG previews are not available here)
OPENSCAD_IMAGE="openscad/openscad@sha256:147e48525bec392bcf628d7a6d5ea4ccac71b16251952328f86e1061cbf47c37"
OPENSCAD_IMAGE_TAG="openscad/openscad:latest"

# KiCad 9.0 — schematic/board generation, ERC/DRC, fab exports (kicad-cli + pcbnew python)
KICAD_IMAGE="kicad/kicad@sha256:e638b79b0321f29395a5b783e94bb9f3c73303e8da15da27b8f5cb4b67a37729"
KICAD_IMAGE_TAG="kicad/kicad:9.0"

# Freerouting 2.3.0 — autorouter (Specctra DSN in, SES out); plain jar, run with --entrypoint java
FREEROUTING_IMAGE="ghcr.io/freerouting/freerouting@sha256:815ee604d0d95fe87cbe8e4671e3db493aee692fbe77e5703aa3f47dd6a1e447"
FREEROUTING_IMAGE_TAG="ghcr.io/freerouting/freerouting:latest"

# qmk_firmware checkout the keyboard is built against (shallow clone at this commit)
QMK_FIRMWARE_REPO="https://github.com/qmk/qmk_firmware"
